<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RepositoryUrl>https://github.com/Foowy/Shoko.Plugin.Oidc</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Title>OIDC Sign-in</Title>
    <Authors>Foowy</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only (host supplies at runtime); must match the Shoko host's bundled version or the plugin fails to load. -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.16.0" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.107" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.BuildTools.Targets" Version="0.3.2" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
